generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model ativo {
  id                         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                       String                      @db.VarChar(200)
  tipo_componente            String                      @db.VarChar(100)
  descricao                  String?
  objetivo                   String?
  dominio_id                 String                      @db.Uuid
  situacao                   String                      @default("Rascunho") @db.VarChar(30)
  criticidade                String?                     @db.VarChar(30)
  usa_cloud                  Boolean                     @default(false)
  data_criacao               DateTime                    @default(now()) @db.Timestamptz(6)
  created_at                 DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                    @default(now()) @db.Timestamptz(6)
  dominio                    dominio                     @relation(fields: [dominio_id], references: [id], map: "fk_ativo_dominio")
  contextualizacao_avaliacao contextualizacao_avaliacao?
  decisao                    decisao[]
  motor_enquadramento        motor_enquadramento?
  papel_ativo                papel_ativo[]

  @@index([dominio_id], map: "ix_ativo_dominio_id")
  @@index([situacao], map: "ix_ativo_situacao")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model catalogo_modelo_fundacional {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fornecedor      String    @db.VarChar(100)
  modelo          String    @db.VarChar(150)
  versao_variante String?   @db.VarChar(100)
  situacao        String    @default("Em_Avaliacao") @db.VarChar(30)
  restricoes_uso  String?
  responsavel_id  String    @db.Uuid
  inicio_vigencia DateTime? @db.Date
  proxima_revisao DateTime? @db.Date
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  pessoa          pessoa    @relation(fields: [responsavel_id], references: [id], map: "fk_catalogo_modelo_responsavel")

  @@unique([fornecedor, modelo, versao_variante], map: "uq_catalogo_modelo")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model catalogo_tecnologia {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome_tec   String   @db.VarChar(150)
  fornecedor String?  @db.VarChar(150)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([nome_tec, fornecedor], map: "uq_catalogo_tecnologia")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model contextualizacao_avaliacao {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ativo_id   String   @unique(map: "uq_contextualizacao_ativo") @db.Uuid
  respostas  Json     @default("{}")
  data       DateTime @default(now()) @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  ativo      ativo    @relation(fields: [ativo_id], references: [id], onDelete: Cascade, map: "fk_contextualizacao_ativo")

  @@index([respostas], map: "ix_contextualizacao_respostas_gin", type: Gin)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model decisao {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ativo_id          String   @db.Uuid
  tipo_decisao      String   @db.VarChar(50)
  responsavel_id    String   @db.Uuid
  justificativa     String
  resultado_decisao String   @db.VarChar(30)
  data              DateTime @default(now()) @db.Timestamptz(6)
  ativo             ativo    @relation(fields: [ativo_id], references: [id], map: "fk_decisao_ativo")
  pessoa            pessoa   @relation(fields: [responsavel_id], references: [id], map: "fk_decisao_responsavel")

  @@index([ativo_id], map: "ix_decisao_ativo_id")
  @@index([responsavel_id], map: "ix_decisao_responsavel_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model dominio {
