/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model papel_ativo {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ativo_id   String   @db.Uuid
  pessoa_id  String   @db.Uuid
  tipo_papel String   @db.VarChar(30)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  ativo      ativo    @relation(fields: [ativo_id], references: [id], onDelete: Cascade, map: "fk_papel_ativo_ativo")
  pessoa     pessoa   @relation(fields: [pessoa_id], references: [id], map: "fk_papel_ativo_pessoa")

  @@unique([ativo_id, pessoa_id, tipo_papel], map: "uq_papel_ativo_pessoa_tipo")
  @@index([ativo_id], map: "ix_papel_ativo_ativo_id")
  @@index([pessoa_id], map: "ix_papel_ativo_pessoa_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model pessoa {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                        String                        @db.VarChar(150)
  email                       String                        @unique(map: "uq_pessoa_email") @db.VarChar(255)
  area                        String?                       @db.VarChar(150)
  senha_hash                  String
  papel_sistema               String                        @default("Usuario") @db.VarChar(20)
  ativo                       Boolean                       @default(true)
  ultimo_login                DateTime?                     @db.Timestamptz(6)
  created_at                  DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                      @default(now()) @db.Timestamptz(6)
  catalogo_modelo_fundacional catalogo_modelo_fundacional[]
  decisao                     decisao[]
  dominio                     dominio[]
  log_auditoria               log_auditoria[]
  papel_ativo                 papel_ativo[]
  refresh_token               refresh_token[]

  @@index([email], map: "ix_pessoa_email")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model refresh_token {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pessoa_id   String    @db.Uuid
  token_hash  String    @unique(map: "uq_refresh_token_hash")
  criado_em   DateTime  @default(now()) @db.Timestamptz(6)
  expira_em   DateTime  @db.Timestamptz(6)
  revogado_em DateTime? @db.Timestamptz(6)
  user_agent  String?   @db.VarChar(255)
  ip_origem   String?   @db.Inet
  pessoa      pessoa    @relation(fields: [pessoa_id], references: [id], onDelete: Cascade, map: "fk_refresh_token_pessoa")

  @@index([expira_em], map: "ix_refresh_token_expira_em")
  @@index([pessoa_id], map: "ix_refresh_token_pessoa_id")
}
