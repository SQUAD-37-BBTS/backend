# Transaction pooler (porta 6543) — usado pela aplicação em runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler / conexão direta (porta 5432) — usado pelo Prisma CLI (migrations)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Resiliência (ordem: DB_QUERY_TIMEOUT_MS < HTTP_TIMEOUT_MS < server.requestTimeout)
HTTP_TIMEOUT_MS=10000

# Schema do Postgres
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=8000

# Autenticação
JWT_SECRET=
JWT_ACCESS_TTL_SEGUNDOS=900
JWT_REFRESH_TTL_DIAS=7

# Rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_BLOQUEIO_MIN=5
RATE_LIMIT_REFRESH_MAX=20

