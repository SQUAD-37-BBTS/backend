# Postgres na VPS (sem pooler) — usado pela aplicação em runtime
DATABASE_URL="postgresql://postgres:[PASSWORD]@[IP_DA_VPS]:5432/backend"

# Mesma conexão — usada pelo Prisma CLI (migrations)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[IP_DA_VPS]:5432/backend"

# Resiliência (ordem: DB_QUERY_TIMEOUT_MS < HTTP_TIMEOUT_MS < server.requestTimeout)
HTTP_TIMEOUT_MS=10000

# Schema do Postgres
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=8000

# Autenticação
JWT_SECRET=
JWT_ACCESS_TTL_SEGUNDOS=900
JWT_REFRESH_TTL_DIAS=7

# CORS (origens separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,https://gdaia-bbts.web.app

# Rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_BLOQUEIO_MIN=5
RATE_LIMIT_REFRESH_MAX=20

# IA (sugestão do questionário). Sem GEMINI_API_KEY o serviço responde 502 e o
# questionário segue 100% manual.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
IA_TIMEOUT_MS=7000
